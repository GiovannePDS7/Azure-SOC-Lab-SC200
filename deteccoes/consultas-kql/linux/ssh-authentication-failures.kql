Syslog
| where Facility in ("auth", "authpriv")
| where ProcessName == "sshd"
| where SyslogMessage startswith "Invalid user" or SyslogMessage has "Failed password"
| extend IpOrigem = extract(@"(\d{1,3}(?:\.\d{1,3}){3})", 1, SyslogMessage)
| extend Usuario = extract(@"(?:Invalid user|Failed password for(?: invalid user)?) (\S+)", 1, SyslogMessage)
| where isnotempty(IpOrigem)
| summarize Falhas = count(),
            Usuarios = dcount(Usuario),
            ListaUsuarios = make_set(Usuario, 10),
            Primeiro = min(TimeGenerated),
            Ultimo = max(TimeGenerated)
    by IpOrigem, Computer
| where Falhas >= 3
