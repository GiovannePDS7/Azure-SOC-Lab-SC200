        {
            "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/f8b203bc-ccd3-485e-b148-4c09e1f77d05')]",
            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/f8b203bc-ccd3-485e-b148-4c09e1f77d05')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "Scheduled",
            "apiVersion": "2023-12-01-preview",
            "properties": {
                "displayName": "[Lab] Entra ID - múltiplas falhas de autenticação 50126",
                "description": "Detecta 5 ou mais falhas de autenticação no Microsoft Entra ID com ResultType 50126 para o mesmo usuário e endereço IP em uma janela de 15 minutos. Regra de laboratório associada à técnica T1110.",
                "severity": "Medium",
                "enabled": true,
                "query": "SigninLogs\r\n| where ResultType == \"50126\"\r\n| where isnotempty(UserPrincipalName)\r\n| summarize\r\n    Falhas = count(),\r\n    Primeiro = min(TimeGenerated),\r\n    Ultimo = max(TimeGenerated)\r\n    by UserPrincipalName, IPAddress\r\n| where Falhas >= 5",
                "queryFrequency": "PT5M",
                "queryPeriod": "PT15M",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
