            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/3df465e2-c6ac-4d9d-8f88-706585f00bfe')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "Scheduled",
            "apiVersion": "2023-12-01-preview",
            "properties": {
                "displayName": "[Lab] Windows - criação de conta local 4720",
                "description": "Detecta a criação de uma conta local no Windows por meio do Event ID 4720. Regra de laboratório associada à técnica T1136.001 - Create Account: Local Account.",
                "severity": "Medium",
